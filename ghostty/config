auto-update-channel = tip

link-previews = false

theme = IC Orange PPL
background-blur = macos-glass-clear
background-opacity = 0.7
background-opacity-cells = true

macos-window-shadow = false
macos-window-buttons = hidden
macos-titlebar-proxy-icon = hidden
confirm-close-surface = false
split-preserve-zoom = navigation
# unfocused-split-opacity = 1
title = " "

# right-click-action = copy
mouse-hide-while-typing = false
cursor-style = bar
scroll-to-bottom = output, no-keystroke
# selection-clear-on-typing = false
selection-clear-on-copy = true
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true
window-inherit-font-size = true
resize-overlay = never

font-size = 20
font-family = 0xproto
# font-family = JetBrainsMono Nerd Font Mono
# font-family = Iosevka Curly Slab
# font-family = maple mono
# font-family = Clarity City

quick-terminal-position = center
quick-terminal-size = 50%,50%
keybind = global:option+backquote=toggle_quick_terminal
macos-shortcuts = ask
# keybind = ctrl+d=unbind
keybind = global:option+enter=new_window
