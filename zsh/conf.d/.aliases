alias ls='ls -FA' 
alias d='dirs -v'
alias dus='du -sh * 2>/dev/null | sort -h'
alias path='print -l $path' 
alias fpath='print -l $fpath' 
alias fjcr='fj repo create -P -r origin -H codeberg.org -S true'

alias -s git='git clone' 
alias -s {py,md,txt}=nvim 
alias -s {swift}="open -a Xcode-beta"
alias -s json='jq .'

ezsh() {
	if [[ -z "$1" ]]; then
		echo "Usage: ezsh <config-name>"
		return 1
	fi
	local i=~zsh/$1
	if [[ -f "$i" ]]; then
		$EDITOR "$i"
	else
		echo "No hash directory found for: $1"
	fi
}
mkcd() {
	mkdir -p "$1" && cd "$1"
}

alias gl='git log'
alias glp='git log -p'
alias glG='git log -E -G'
alias glg='git log -E --grep'
alias gls='git log --stat'
alias glS='git log -S'
alias glgd='git log --graph --decorate'
alias glod='git log --oneline --decorate'
alias glfb='git log --pretty=format:"%h %d %s%n%b" --decorate'
alias gc='git commit --verbose'
alias gcm='git commit -m'
alias gcam='git commit --all --message'
alias gca='git commit --verbose --all'
alias gcad='git commit --verbose --amend'
alias gcadm='git commit --amend --message'
alias ga='git add'
alias gaa='git add --all'
alias gb='git branch -a -vv'
alias gbd='git branch -d'
alias gbD='git branch -D'
alias gsw='git switch'
alias gswc='git switch -c'
alias gcl='git clone'
alias gp='git push'
alias gpo='git push origin'
alias gpuom='git push -u origin main'
alias gf='git fetch'
alias gpl='git pull'
alias gplr='git pull --rebase'
alias gplm='git pull --merge'
alias grs='git restore --staged'
alias gr='git restore'
alias grt='git remote -v'
alias grta='git remote add'
alias gss='git status --short'
alias gs='git status'
alias gsv='git status -vv'
alias gt='git tag'
alias gta='git tag -a'
alias gtl='git tag'
alias gtd='git tag -d'
alias gd='git diff'
alias gds='git diff --staged'
alias gdh='git diff HEAD'
alias gm='git merge'
alias grb='git rebase'

if [[ "$OSTYPE" == darwin* ]]; then
	alias mdfind='mdfind 2>/dev/null'
	alias bbl="brew bundle list --file $XDG_CONFIG_HOME/homebrew/Brewfile"
	alias bbd="brew bundle dump --force --file $XDG_CONFIG_HOME/homebrew/Brewfile"
	alias commit='fm respond --model pcc "System Prompt: Git Commit Message Drafter\n - Output format: single line only, no body or footer.\n Prefix with standard type: chore:, fix:, add:, update:, remove:, refactor:, docs:, test:.\n Write concise imperative summary of change; keep under 72 characters.\n No extra text—message only in header. $(gs && gdh)"'
	alias gcf='ghostty +edit-config'
	alias ff='fastfetch'
	alias flush-dns='sudo dscacheutil -flushcache && sudo killall -HUP mDNSResponder'
	alias list-xc-components='xcrun simctl list devices; xcrun simctl list runtimes; xcrun simctl --set ~/Library/Developer/Xcode/UserData/Previews/Simulator\ Devices list devices; xcrun simctl --set ~/Library/Developer/XCPGDevices list devices'
fi
