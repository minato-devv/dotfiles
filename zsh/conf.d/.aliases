alias \
la='ls -AFt' \
ll='ls -Alht' \
s='du -hs' \
grep='grep --color=always -nHIE' \
which='which -a' \
qpath='print -l $path | xargs -I {} ls -1 {} 2>/dev/null | grep -hIE' \
ql='qlmanage -p' \
top='top -s 10 -n 15 -o mem -stats command,cpu,mem,state,time,pid' \
cycles="system_profiler SPPowerDataType | sed -nE 's/^.*Cycle Count: ([0-9]+)/\1/p'" \
{ei,energy-impact}='sudo powermetrics -n 1 --samplers tasks --show-process-energy | head -n 50' \
pds='pmset displaysleepnow' \
flush-dns='sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder' \
bckp-dotfiles='rsync -avP --delete --exclude ".git/" --exclude ".DS_Store" "$HOME/Dev/dotfiles/" "/Users/user/Library/Mobile Documents/com~apple~CloudDocs/Documents/dotfiles-bckp/"' \
mcma='make clean && make all' \
nosleep='caffeinate -s &' \
allowsleep='killall caffeinate' \
bugcp='brew update; brew upgrade --greedy; brew cleanup --prune=all' \
bbl='brew bundle list --file ~/.homebrew/Brewfile' \
bbd='brew bundle dump --force --file ~/.homebrew/Brewfile' \
path='print -l $path' \
fpath='print -l $fpath' \
icloud='cd "$HOME/Library/Mobile Documents/com~apple~CloudDocs"' \
giturl="git config --get remote.origin.url | sed -E 's/^(https:\/\/github.com\/|git@github.com:)([^/:]+\/[^.]+)(\.git)?$/https:\/\/github.com\/\2\.git/'" \
gitrem='open $(giturl)' \
gitalias="alias | \grep '^g'" \
commit='fm respond --model pcc "You are an expert developer and git user who generates best practice, detailed, and easy-to-read commit messages.\nGenerate a git commit message based on the following git diff. Output only the message. Include a header for the generic commit message and a body separated by a blank line that outline the changes in greater detail. Start the header with chore, fix, add, feature, etc that best fits the commit.\n$(gdh)"'

bckp-studies() {
	rsync -avP --delete --exclude '.TemporaryItems' --exclude '.DocumentRevisions-V100' --exclude '.Spotlight-*' --exclude '.Trashes' --exclude '.fseventsd' "/Volumes/Studies/" "/Users/user/Library/Mobile Documents/com~apple~CloudDocs/Academics/"
}

copypath() { 
	realpath "$1" | tr -d '\n' | pbcopy 
	echo "Copied location of $1 to clipboard"
}

mkcd() {
	mkdir -p "$1" && cd "$1"
}

z() {
    local file
    case "$1" in
	r) exec $SHELL -li ;;
        i) file="$ZDOTDIR/.zshrc" ;;
        v) file="$HOME/.zshenv" ;;
        p) file="$ZDOTDIR/.zprofile" ;;
        a) file="$ZDOTDIR/conf.d/.aliases" ;;
        ag) file="$ZDOTDIR/conf.d/.git_aliases" ;;
	b) file="$ZDOTDIR/conf.d/.bindkey" ;;
	f) file="$ZDOTDIR/conf.d/.vcs_info" ;;
	t) file="$ZDOTDIR/conf.d/.transient_prompt" ;;
	g) file="$XDG_CONFIG_HOME/ghostty/config" ;;
        *) return 1 ;;
    esac
	case "$2" in
		s) source "$file" ;;
		e|"") "${EDITOR:-vim}" "$file" ;;
		c) cat "$file" | ${PAGER:-more} ;;
		*) return 1 ;;
	esac
}

list_repos() {
	find $HOME/Dev -maxdepth 3 -type f -path '*/.git/config' -exec grep -EIoh '(https:\/\/github.com\/|git@github.com:)([^/:]+\/[^.]+)(\.git)?' {} +
}

mvers() {
	sw_vers | awk '/ProductVersion:/{v=$2}/BuildVersion:/{b=$2}END{print "macOS "v" ("b")"}'
}

releases-rss() {
	curl -s https://developer.apple.com/news/releases/rss/releases.rss | \
  grep -E '(title|pubDate)' | \
  sed -e 's/^[ \t]*//' \
      -e 's/<title>//g' -e 's/<\/title>//g' \
      -e 's/<pubDate>//g' -e 's/<\/pubDate>//g' | \
  tail -n +3 | \
  paste - - | \
  awk -F'\t' '{printf "\033[1;32m%s\033[0m\n  %s\n\n", $1, $2}'
}

fmc() {
	fm respond -m system "Write a git commit message based on the following git diff. Output only the commit message and be specific, citing specific terms: $(git diff $@)"
}
