bindkey -N mymap .safe # Create a new keymap based on the .safe keymap
bindkey -A mymap main # Alias mymap to main to set as active keymap

bindkey -M mymap '^[[C' forward-char
bindkey -M mymap '^[[D' backward-char
bindkey -M mymap '^?' backward-delete-char
bindkey -M mymap '^[[A' up-line-or-history
bindkey -M mymap '^[[B' down-line-or-history
bindkey -M mymap '^V' quoted-insert
bindkey -M mymap '^I' expand-or-complete
bindkey -M mymap '^[[200~' bracketed-paste

bindkey -M mymap '^A' beginning-of-line
bindkey -M mymap '^E' end-of-line

bindkey -M mymap '^R' history-incremental-search-backward

autoload -Uz edit-command-line && zle -N edit-command-line
bindkey '^X^E' edit-command-line
