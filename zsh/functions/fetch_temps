local target=${1:-all}

case $target in
	cpu)
		local cpu_temp=$(smctemp -c 2>/dev/null)
		TEMP_INFO="C:${cpu_temp}"
		;;
	gpu)
		local gpu_temp=$(smctemp -g 2>/dev/null)
		TEMP_INFO="G:${gpu_temp}"
		;;
	all|*)
		local cpu_temp=$(smctemp -c 2>/dev/null)
		local gpu_temp=$(smctemp -g 2>/dev/null)
		TEMP_INFO="C:${cpu_temp} G:${gpu_temp}"
		;;
esac
